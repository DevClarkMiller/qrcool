@Library('pipeline-lib') _

pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'Force',
            defaultValue: false,
            description: 'Runs all even if there are no changes'
        )
    }

    environment {
        PACKAGE         = 'backend/package.json'
        PACKAGE_LOCK    = 'backend/package-lock.json'
        JENKINS         = 'backend/Jenkinsfile'
        CHANGE_SRC      = 'backend/src/**'
        PRISMA          = 'backend/prisma/**'
        REGISTRY        = 'ghcr.io'
        IMAGE_NAME      = 'devclarkmiller/qrcool'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        GHCR_CREDS_ID   = 'portfolio-pipeline'
        DEPLOY_DIR      = '/srv/qrcool'
        ENV_ID          = 'qrcool-backend-production-env'
    }

    stages {
        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        // stage("Vulnerability Check") {
        //     when {
        //         anyOf {
        //             changeset CHANGE_SRC
        //             changeset JENKINS
        //             changeset PACKAGE
        //             changeset PACKAGE_LOCK
        //             expression { return params.Force }
        //         }
        //     }
        //     steps {
        //         dir('frontend') {
        //             sh 'npm audit --audit-level=high'
        //         }
        //     }
        // }

        stage("Test") {
            when {
                anyOf {
                    changeset CHANGE_SRC
                    changeset JENKINS
                    changeset PACKAGE
                    changeset PACKAGE_LOCK
                    changeset PRISMA
                    expression { return params.Force }
                }
            }
            steps {
                dir('backend') {
                    withCredentials([file(credentialsId: ENV_ID, variable: 'ENV_FILE')]) {
                        sh '''
                            set -eux

                            cp "$ENV_FILE" .env

                            IMAGE_ID=$(docker build -q --target test .)
                            docker run --rm --env-file .env "$IMAGE_ID" sh -c '
                                set -eux
                                echo "[Test] Development"
                                npm run test:dev
                            '
                        '''
                    }
                }
            }
        }

        stage("Prisma Migrate") {
            when {
                anyOf {
                    changeset PRISMA
                    expression { return params.Force }
                }
            }
            options {
                timeout(time: 5, unit: 'MINUTES')
            }
            steps {
                dir('backend') {
                    withCredentials([file(credentialsId: ENV_ID, variable: 'ENV_FILE')]) {
                        sh '''
                            set -eux

                            cp "$ENV_FILE" .env.test

                            IMAGE_ID=$(docker build -q .)
                            trap 'rm -f .env; docker image rm "$IMAGE_ID" || true' EXIT

                            docker run --rm --env-file .env "$IMAGE_ID" sh -c '
                                set -eux
                                npm run prisma:generate
                                npm run prisma:migrate:deploy:dev
                                npm run prisma:seed
                            '
                        '''
                    }
                    sh '''
                        set -eux

                        IMAGE_ID=$(docker build -q .)
                        trap 'docker image rm "$IMAGE_ID" || true' EXIT
                        docker run --rm --entrypoint /bin/sh "$IMAGE_ID" -c '
                            set -eux
                            npm run prisma:generate
                            npm run prisma:migrate:deploy:dev
                            npm run prisma:seed
                        '
                    '''
                }
            }
        }

        stage("Build to GHCR") {
            when {
                anyOf {
                    changeset CHANGE_SRC
                    changeset JENKINS
                    changeset PACKAGE
                    changeset PACKAGE_LOCK
                    changeset PRISMA
                    expression { return params.Force }
                }
            }
            steps {
                script {
                    docker.withRegistry("https://${REGISTRY}", GHCR_CREDS_ID) {
                        sh """
                            set -eux

                            docker rmi ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:latest || true
                            docker build --no-cache \
                                -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} \
                                -t ${REGISTRY}/${IMAGE_NAME}:latest \
                                ./backend

                            docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                            docker push ${REGISTRY}/${IMAGE_NAME}:latest
                            docker image rm ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:latest || true
                        """
                    }
                }
            }
        }

        stage("Deploy Docker Compose") {
            when {
                anyOf {
                    changeset CHANGE_SRC
                    changeset JENKINS
                    changeset PACKAGE
                    changeset PACKAGE_LOCK
                    changeset PRISMA
                    expression { return params.Force }
                }
            }
            steps {
                dir('backend') {
                    sh '''
                        set -eux

                        mkdir -p "$DEPLOY_DIR"
                        cp .env.production "$DEPLOY_DIR/.env"
                        chmod 600 "$DEPLOY_DIR/.env"
                        cp docker-compose.yml "$DEPLOY_DIR/docker-compose.yml"
                    '''
                }
            }
        }

        stage("Deploy Docker Image") {
            when {
                anyOf {
                    changeset CHANGE_SRC
                    changeset JENKINS
                    changeset PACKAGE
                    changeset PACKAGE_LOCK
                    changeset PRISMA
                    expression { return params.Force }
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: GHCR_CREDS_ID,
                    usernameVariable: 'GHCR_USER',
                    passwordVariable: 'GHCR_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        echo "$GHCR_TOKEN" | docker login "$REGISTRY" -u "$GHCR_USER" --password-stdin

                        docker compose -f "$DEPLOY_DIR/docker-compose.yml" pull qrcool
                        docker compose -f "$DEPLOY_DIR/docker-compose.yml" up -d --remove-orphans
                    '''
                }
            }
        }
    }
}
